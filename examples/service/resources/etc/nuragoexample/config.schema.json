{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "JSON schema for nuragoexample configuration",
  "properties": {
    "clients": {
      "additionalProperties": false,
      "description": "Configuration for external service clients",
      "properties": {
        "ipify": {
          "additionalProperties": false,
          "description": "Configuration for the ipify service client",
          "examples": [
            {
              "address": "https://api.ipify.org",
              "timeout": 15
            }
          ],
          "properties": {
            "address": {
              "default": "",
              "description": "Base URL of the service",
              "examples": [
                "https://api.ipify.org"
              ],
              "title": "Address",
              "type": "string"
            },
            "timeout": {
              "default": 1,
              "description": "HTTP client timeout [seconds]",
              "examples": [
                15
              ],
              "title": "Timeout",
              "type": "integer"
            }
          },
          "required": [
            "address",
            "timeout"
          ],
          "title": "ipify service client",
          "type": "object"
        }
      },
      "required": [
        "ipify"
      ],
      "title": "Clients",
      "type": "object"
    },
    "db": {
      "additionalProperties": false,
      "description": "Configuration of the databases",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable or disable the database",
          "type": "boolean"
        },
        "main": {
          "additionalProperties": false,
          "description": "Configuration of the main database (read/write)",
          "examples": [
            {
              "conn_max_idle_count": 2,
              "conn_max_idle_time": 60,
              "conn_max_lifetime": 3600,
              "conn_max_open": 5,
              "dsn": "username:password@protocol(address)/dbname?param=value",
              "timeout_ping": 1
            }
          ],
          "properties": {
            "conn_max_idle_count": {
              "default": 5,
              "description": "Maximum number of connections in the idle connection pool",
              "examples": [
                5
              ],
              "type": "integer"
            },
            "conn_max_idle_time": {
              "default": 60,
              "description": "Maximum amount of time a connection may be idle [seconds]",
              "examples": [
                60
              ],
              "type": "integer"
            },
            "conn_max_lifetime": {
              "default": 3600,
              "description": "Maximum amount of time a connection may be reused [seconds]",
              "examples": [
                3600
              ],
              "type": "integer"
            },
            "conn_max_open": {
              "default": 50,
              "description": "Maximum number of open connections to the database. If n <= 0, there is no limit on the number of open connections",
              "examples": [
                50
              ],
              "type": "integer"
            },
            "driver": {
              "default": "mysql",
              "description": "Database driver name, used when the DSN does not include a <driver>:// prefix",
              "examples": [
                "mysql"
              ],
              "type": "string"
            },
            "dsn": {
              "default": "",
              "description": "Database in DSN format, optionally prefixed with the driver name: [<driver>://]username:password@protocol(address)/dbname?param=value",
              "type": "string"
            },
            "timeout_ping": {
              "default": 1,
              "description": "Database healthcheck ping timeout [seconds]",
              "examples": [
                1
              ],
              "type": "integer"
            }
          },
          "required": [
            "conn_max_idle_count",
            "conn_max_idle_time",
            "conn_max_lifetime",
            "conn_max_open",
            "dsn",
            "timeout_ping"
          ],
          "title": "Main database configuration",
          "type": "object"
        },
        "read": {
          "additionalProperties": false,
          "description": "Configuration of the read-replica database (read-only)",
          "examples": [
            {
              "conn_max_idle_count": 2,
              "conn_max_idle_time": 60,
              "conn_max_lifetime": 3600,
              "conn_max_open": 5,
              "dsn": "username:password@protocol(address)/dbname?param=value",
              "timeout_ping": 1
            }
          ],
          "properties": {
            "conn_max_idle_count": {
              "default": 5,
              "description": "Maximum number of connections in the idle connection pool",
              "examples": [
                5
              ],
              "type": "integer"
            },
            "conn_max_idle_time": {
              "default": 60,
              "description": "Maximum amount of time a connection may be idle [seconds]",
              "examples": [
                60
              ],
              "type": "integer"
            },
            "conn_max_lifetime": {
              "default": 3600,
              "description": "Maximum amount of time a connection may be reused [seconds]",
              "examples": [
                3600
              ],
              "type": "integer"
            },
            "conn_max_open": {
              "default": 50,
              "description": "Maximum number of open connections to the database. If n <= 0, there is no limit on the number of open connections",
              "examples": [
                50
              ],
              "type": "integer"
            },
            "driver": {
              "default": "mysql",
              "description": "Database driver name, used when the DSN does not include a <driver>:// prefix",
              "examples": [
                "mysql"
              ],
              "type": "string"
            },
            "dsn": {
              "default": "",
              "description": "Database in DSN format, optionally prefixed with the driver name: [<driver>://]username:password@protocol(address)/dbname?param=value",
              "type": "string"
            },
            "timeout_ping": {
              "default": 1,
              "description": "Database healthcheck ping timeout [seconds]",
              "examples": [
                1
              ],
              "type": "integer"
            }
          },
          "required": [
            "conn_max_idle_count",
            "conn_max_idle_time",
            "conn_max_lifetime",
            "conn_max_open",
            "dsn",
            "timeout_ping"
          ],
          "title": "Read-replica database configuration",
          "type": "object"
        }
      },
      "required": [
        "main",
        "read"
      ],
      "title": "Database configuration",
      "type": "object"
    },
    "enabled": {
      "default": true,
      "description": "Enable or disable the service",
      "title": "Enabled",
      "type": "boolean"
    },
    "log": {
      "additionalProperties": false,
      "description": "Logger settings",
      "properties": {
        "address": {
          "default": "",
          "description": "(OPTIONAL) Network address of the (r)Syslog daemon (ip:port) or just (:port)",
          "type": "string"
        },
        "format": {
          "default": "JSON",
          "description": "Defines the default log format",
          "enum": [
            "CONSOLE",
            "JSON"
          ],
          "type": "string"
        },
        "level": {
          "default": "DEBUG",
          "description": "Defines the default log level",
          "enum": [
            "EMERGENCY",
            "ALERT",
            "CRITICAL",
            "ERROR",
            "WARNING",
            "NOTICE",
            "INFO",
            "DEBUG"
          ],
          "type": "string"
        },
        "network": {
          "default": "",
          "description": "(OPTIONAL) Network type used by the (r)Syslog",
          "enum": [
            "",
            "udp",
            "tcp"
          ],
          "type": "string"
        }
      },
      "required": [
        "address",
        "format",
        "level",
        "network"
      ],
      "title": "Logger",
      "type": "object"
    },
    "remoteConfigData": {
      "default": "",
      "description": "Base64 encoded JSON configuration data to be used with the 'envvar' provider",
      "title": "Remote Configuration Data",
      "type": "string"
    },
    "remoteConfigEndpoint": {
      "default": "",
      "description": "Remote configuration URL (ip:port), passed to the custom remote loader",
      "title": "Remote Configuration Endpoint",
      "type": "string"
    },
    "remoteConfigPath": {
      "default": "",
      "description": "Remote configuration path in which to search for the configuration data (e.g. '/config/nuragoexample'), passed to the custom remote loader",
      "title": "Remote Configuration Path",
      "type": "string"
    },
    "remoteConfigProvider": {
      "default": "",
      "description": "Remote configuration source type: 'envvar' or empty (other values require a custom remote loader registered via the config.WithRemoteLoader option)",
      "enum": [
        "",
        "envvar"
      ],
      "title": "Remote Configuration Provider",
      "type": "string"
    },
    "remoteConfigSecretKeyring": {
      "default": "",
      "description": "Path to an optional secret keyring used by the custom remote loader to decrypt the remote configuration data (e.g. '/etc/nuragoexample/configkey.gpg')",
      "title": "Remote Configuration Secret Keyring",
      "type": "string"
    },
    "servers": {
      "additionalProperties": false,
      "description": "Configuration for exposed servers",
      "properties": {
        "grpc": {
          "additionalProperties": false,
          "description": "Configuration for the gRPC server. TLS is enabled when both tls_cert_file and tls_key_file are set.",
          "examples": [
            {
              "address": ":8074",
              "enabled": true,
              "reflection": false,
              "timeout": 60,
              "tls_cert_file": "",
              "tls_key_file": ""
            }
          ],
          "properties": {
            "address": {
              "default": ":8074",
              "description": "gRPC address (ip:port) or just (:port)",
              "examples": [
                ":8074"
              ],
              "title": "Address",
              "type": "string"
            },
            "enabled": {
              "default": false,
              "description": "Enable or disable the gRPC server",
              "title": "Enabled",
              "type": "boolean"
            },
            "reflection": {
              "default": false,
              "description": "Enable the gRPC server reflection service. Enable it only on listeners that are not reachable from untrusted networks.",
              "title": "Reflection",
              "type": "boolean"
            },
            "timeout": {
              "default": 60,
              "description": "Deadline applied to unary RPCs that arrive without one [seconds]",
              "examples": [
                60
              ],
              "title": "Timeout",
              "type": "integer"
            },
            "tls_cert_file": {
              "default": "",
              "description": "Path of the PEM-encoded TLS certificate file",
              "title": "TLS certificate file",
              "type": "string"
            },
            "tls_key_file": {
              "default": "",
              "description": "Path of the PEM-encoded TLS private key file",
              "title": "TLS key file",
              "type": "string"
            }
          },
          "required": [
            "enabled"
          ],
          "title": "gRPC server",
          "type": "object"
        },
        "monitoring": {
          "additionalProperties": false,
          "description": "Configuration for the monitoring server",
          "examples": [
            {
              "address": ":8071",
              "timeout": 60
            }
          ],
          "properties": {
            "address": {
              "default": "",
              "description": "HTTP address (ip:port) or just (:port)",
              "examples": [
                ":8071"
              ],
              "title": "Address",
              "type": "string"
            },
            "timeout": {
              "description": "HTTP request timeout [seconds]",
              "examples": [
                60
              ],
              "title": "Timeout",
              "type": "integer"
            }
          },
          "required": [
            "address",
            "timeout"
          ],
          "title": "Monitoring HTTP server",
          "type": "object"
        },
        "private": {
          "additionalProperties": false,
          "description": "Configuration for the private server",
          "examples": [
            {
              "address": ":8072",
              "timeout": 60
            }
          ],
          "properties": {
            "address": {
              "default": "",
              "description": "HTTP address (ip:port) or just (:port)",
              "examples": [
                ":8072"
              ],
              "title": "Address",
              "type": "string"
            },
            "timeout": {
              "description": "HTTP request timeout [seconds]",
              "examples": [
                60
              ],
              "title": "Timeout",
              "type": "integer"
            }
          },
          "required": [
            "address",
            "timeout"
          ],
          "title": "Private HTTP server",
          "type": "object"
        },
        "public": {
          "additionalProperties": false,
          "description": "Configuration for the public server",
          "examples": [
            {
              "address": ":8073",
              "timeout": 60
            }
          ],
          "properties": {
            "address": {
              "default": "",
              "description": "HTTP address (ip:port) or just (:port)",
              "examples": [
                ":8073"
              ],
              "title": "Address",
              "type": "string"
            },
            "timeout": {
              "description": "HTTP request timeout [seconds]",
              "examples": [
                60
              ],
              "title": "Timeout",
              "type": "integer"
            }
          },
          "required": [
            "address",
            "timeout"
          ],
          "title": "Public HTTP server",
          "type": "object"
        }
      },
      "required": [
        "monitoring",
        "private",
        "public"
      ],
      "title": "Servers",
      "type": "object"
    },
    "shutdown_timeout": {
      "default": 30,
      "description": "Time in seconds to wait on exit for a graceful shutdown.",
      "title": "ShutDown Timeout",
      "type": "integer"
    }
  },
  "required": [
    "clients",
    "db",
    "enabled",
    "log",
    "servers"
  ],
  "title": "Configuration for nuragoexample",
  "type": "object"
}
